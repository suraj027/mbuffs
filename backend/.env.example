# Backend Server Port (optional, defaults to 5001 in server.ts)
# PORT=5001

# Neon PostgreSQL Database Connection URL (using Neon HTTP driver format)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Frontend URL - this is where the user is redirected after successful login
FRONTEND_URL="http://localhost:8080"

# Better Auth Base URL - your backend URL
BETTER_AUTH_URL="http://localhost:5001"

# Better Auth Secret - generate a secure random string (at least 32 characters)
# You can generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET_AT_LEAST_32_CHARS"

# Production setting
# NODE_ENV=production

# --- Google OAuth --- 
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# NOTE: With Better Auth, the redirect URI is automatically set to:
# {BETTER_AUTH_URL}/api/auth/callback/google
# Make sure this URL is added to your Google OAuth authorized redirect URIs

# --- Cloudflare Turnstile (Captcha) ---
# Get from Cloudflare Dashboard -> Turnstile
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

# --- Optional: Other OAuth Providers ---
# GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
# GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# --- TMDB API ---
TMDB_API_KEY="YOUR_TMDB_API_KEY"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# --- Web Push (VAPID) ---
# VAPID keys authenticate your server with browser push services (FCM, APNs, Mozilla)
# so they know who is sending push notifications. Generate once with:
#   npx web-push generate-vapid-keys
# Public key is shared with the browser; private key signs payloads on the server.
# Subject is a mailto: or URL so push services can contact you if something goes wrong.
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:your@email.com"

# --- OMDB API ---
# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY="YOUR_OMDB_API_KEY"
# Optional fallback key used when the primary key fails or hits its daily limit
OMDB_API_KEY_2="YOUR_OMDB_API_KEY_2"

# --- Scraper microservice (IMDB parental guidance) ---
# IMDB blocks the main backend's IP with anti-bot challenges, so parental guidance
# scraping is delegated to a separate Vercel project (the `scraper/` package in this repo).
# SCRAPER_URL is the base URL of that deployed scraper service (no trailing slash).
# SCRAPER_API_KEY is the shared secret the backend sends as `x-scraper-key`; it must
# match the SCRAPER_API_KEY configured on the scraper service.
SCRAPER_URL="https://your-scraper-service.vercel.app"
SCRAPER_API_KEY="YOUR_SCRAPER_SHARED_SECRET_AT_LEAST_32_CHARS"

# --- Codex (Reddit scraper) ---
# The Reddit scraper uses the OpenAI Codex SDK (@openai/codex-sdk) for movie-title extraction.
# Auth is inherited from the Codex CLI, so run `codex login` once with your ChatGPT/Codex subscription
# before running `npm run scrape:reddit`. No env var is required for auth.
# Optional: override the model used by Codex for extraction.
# CODEX_MODEL="gpt-5-codex"
