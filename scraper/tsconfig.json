{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],

    "module": "Node16",
    "rootDir": ".",
    "moduleResolution": "node16",
    "resolveJsonModule": true,

    "allowJs": true,

    "outDir": "dist",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": true,

    "skipLibCheck": true
  },
  "include": ["api", "services", "middleware", "lib"],
  "exclude": ["node_modules", "dist"]
}